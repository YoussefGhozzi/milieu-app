{
  "expo": {
    "name": "MILIEU",
    "slug": "milieu",
    "scheme": "milieu",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "tn.milieu.app",
      "supportsTablet": true
    },
    "android": {
      "package": "tn.milieu.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "MILIEU",
      "themeColor": "#FF3C00"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "MILIEU utilise la caméra pour scanner les tickets QR des clients à l’entrée des cours."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "supportsRTL": true
    }
  }
}
